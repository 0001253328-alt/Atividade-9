programa {
  funcao inicio() {
  real valores[3]

  escreva("Digite o valor da posição 0: ")
  leia(valores[0])

  escreva("Digite o valor da posição 1: ")
  leia(valores[1])

  valores[2] = valores[0] + valores[1]

  escreva("Posição 0: ", valores[0], "\n")
  escreva("Posição 1: ", valores[1], "\n")
  escreva("Posição 2: ", valores[2])
  }
}
